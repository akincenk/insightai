# Required: OpenAI API key used for embeddings and answers
OPENAI_API_KEY=
# Required: clients must send this value in the X-API-Key header on /upload/ and /query/.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Local development only: set to true to run without API_KEY (no authentication at all).
ALLOW_NO_AUTH=false
# Optional overrides
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4-mini
MAX_UPLOAD_MB=10
MAX_CHUNKS_PER_UPLOAD=200
MAX_STORE_CHUNKS=2000
# Comma-separated browser origins allowed to call the API (empty = CORS disabled)
ALLOWED_ORIGINS=
